# -----------------------------------------------------------------------------
#  Intelligent Network Packet Analyzer — variables d'environnement
#  Copiez ce fichier en « .env » et renseignez vos valeurs.
#  Le fichier .env n'est JAMAIS versionné : il ne doit contenir que des secrets
#  ou des réglages propres à une machine.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
#  Backend
# -----------------------------------------------------------------------------

# Jeton partagé entre l'agent et le backend. L'agent doit le présenter pour écrire.
# L'engendrer :  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Laisser vide en développement : le backend en engendre un au démarrage et l'affiche.
# En production, il est obligatoire : un jeton recréé à chaque redémarrage ne pourrait
# plus être connu de l'agent.
ANALYZER_AGENT_TOKEN=

# developpement | test | preproduction | production
ANALYZER_ENV=developpement

# Interface et port d'écoute du backend.
# 127.0.0.1 : joignable depuis cette machine seulement (développement).
# 0.0.0.0   : joignable depuis le réseau local — nécessaire pour tester depuis un
#             téléphone, mais alors la page est visible par tout le réseau.
ANALYZER_HOST=127.0.0.1
ANALYZER_PORT=8000

# Nombre de paquets conservés en mémoire (phase 1). Au-delà, les plus anciens sont
# oubliés — le total reçu reste juste, puisqu'il est compté séparément.
ANALYZER_TAILLE_MEMOIRE=2000

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules.
# Le tableau de bord est servi par ce même serveur : aucune origine externe n'a besoin
# d'appeler l'API. Ne JAMAIS mettre « * » ici.
ANALYZER_ORIGINES_CORS=http://127.0.0.1:8000,http://localhost:8000

# Requêtes d'ingestion acceptées par minute et par adresse. Protège contre un agent
# emballé (boucle d'erreur) et contre un porteur de jeton trop bavard.
ANALYZER_LIMITE_INGESTION=120

# -----------------------------------------------------------------------------
#  Enrichissement des adresses IP — phase 4, pas encore utilisé
# -----------------------------------------------------------------------------
# Les adresses privées (192.168.x.x, 10.x.x.x, 127.x.x.x…) ne sont JAMAIS envoyées :
# elles ne désignent rien à l'extérieur, et les transmettre serait une fuite inutile.

# ipinfo.io — géolocalisation, opérateur (ASN) et organisation. 50 000 requêtes/mois.
# Jeton à créer sur https://ipinfo.io/signup
IPINFO_TOKEN=

# AbuseIPDB — score de réputation d'abus : l'adresse est-elle connue pour scanner,
# spammer ou attaquer ? 1 000 requêtes/jour. Jeton sur https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# -----------------------------------------------------------------------------
#  Base de données Supabase — phase 5, pas encore utilisé
# -----------------------------------------------------------------------------
# La clé « service_role » contourne les règles de sécurité au niveau des lignes.
# Elle ne doit exister QUE côté backend : jamais dans le navigateur, jamais dans
# l'agent, jamais dans un dépôt Git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Schéma dédié, pour ne rien mélanger avec d'éventuelles autres tables du projet.
SUPABASE_SCHEMA=analyzer

# Durée de conservation des données, en jours. Décision prise avec l'auteur du projet :
# le tableau de bord est public, donc rien ne s'accumule indéfiniment.
ANALYZER_RETENTION_JOURS=30

# --- Couche IA facultative (phase 3) ------------------------------------------
# FACULTATIVE, et désactivée tant que la clé est vide. Quand elle est inactive, les
# explications viennent du moteur de règles et sont complètes : aucune fonctionnalité
# n'en dépend. Elle ne fait que reformuler des explications déjà écrites, et n'ajoute
# jamais d'information.
#
# L'adresse est compatible OpenAI : elle couvre OpenAI, Mistral, Groq, ou une instance
# locale (Ollama, vLLM) sans changer une ligne de code.
#
# ATTENTION — les explications envoyées contiennent des adresses IP et des numéros de
# port de votre réseau. Activer cette couche revient à les transmettre au fournisseur
# choisi. C'est la raison pour laquelle elle est désactivée par défaut, et que l'interface
# affiche « réformulé par IA » quand elle est utilisée.
ANALYZER_LLM_KEY=
ANALYZER_LLM_URL=https://api.openai.com/v1/chat/completions
ANALYZER_LLM_MODEL=gpt-4o-mini
